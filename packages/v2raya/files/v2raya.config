config v2raya 'config'
	option enabled '0'

	# Listening address of the web UI
	option address '0.0.0.0:2017'

	# Make sure your IPv6 network works fine before you turn it on.
	# Optional values: auto, on, off.
	option ipv6_support 'auto'

	# Experimental feature. Make sure you have installed nftables.
	# Optional values: auto, on, off.
	option nftables_support 'auto'

	# Optional values: trace, debug, info, warn or error
	option log_level 'info'

	# Maximum number of days to keep log files
	option log_max_days '3'

	option log_disable_color '1'

	option log_disable_timestamp '0'

	# Executable v2raya_core path. Auto-detect if empty.
	option v2ray_bin ''

	# Additional core config directory; files in it are combined with the
	# config generated by v2rayA.
	option v2ray_confdir ''

	# Directory containing geoip.dat and geosite.dat. The official
	# v2ray-geoip and v2ray-geosite packages install them here.
	option v2ray_assetsdir '/usr/share/v2ray'

	# Executable run around transparent proxy setup/teardown. v2rayA
	# passes --transparent-type and --stage (pre-start, post-start,
	# pre-stop, post-stop).
	option transparent_hook ''

	# Executable run around core start/stop. v2rayA passes --stage
	# (pre-start, post-start, pre-stop, post-stop).
	option core_hook ''

	# Executable used to parse/configure protocols v2rayA does not know.
	option plugin_manager ''
